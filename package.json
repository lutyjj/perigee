{
  "name": "perigee",
  "version": "0.2.0",
  "description": "Mirrors the app libraries of paired Moonshine hosts into Steam as non-Steam shortcuts that launch Moonlight.",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "moonlight",
    "moonshine"
  ],
  "author": "lutyjj",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "rollup": "^4.63.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
